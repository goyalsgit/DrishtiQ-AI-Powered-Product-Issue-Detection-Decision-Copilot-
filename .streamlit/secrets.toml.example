# TEMPLATE ONLY - do not put your real key in this file (it can be committed).
# Copy it:  cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# Then put the real key in .streamlit/secrets.toml, which is gitignored.
# On Streamlit Community Cloud, paste the same lines into App settings -> Secrets.

GOOGLE_API_KEY = "paste-your-gemini-key-here"
GEMINI_MODEL = "gemini-3.5-flash-lite"

# Optional: company review database (free Neon Postgres). Without it, a local demo file is used.
# COMPANY_DB_URL = "postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
